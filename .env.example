# ==============================================================================
# SCRIPTIFY ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# --- DATABASE CONFIGURATION ---
# Replace with your DB connection string (MySQL/PostgreSQL)
DB_URL=jdbc:mysql://localhost:3306/your_db_name
DB_USERNAME=your_username
DB_PASSWORD=your_password

# --- SECURITY & AUTHENTICATION ---
# Generate a strong HS512 secret key (min 64 chars)
JWT_SECRET=your_super_secret_signing_key
# Expiration time in milliseconds (e.g., 86400000 for 1 day)
JWT_EXPIRATION=86400000

# --- CLOUDFLARE R2 STORAGE (S3 COMPATIBLE) ---
# Your Cloudflare Account ID (Found in R2 Dashboard)
R2_ACCOUNT_ID=your_account_id
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# API Token Keys (Must have Object Read/Write permissions)
R2_ACCESS_KEY=your_access_key_id
R2_SECRET_KEY=your_secret_access_key

# The name of your R2 bucket
R2_BUCKET_NAME=your_bucket_name

# Public URL (R2.dev subdomain or your custom domain)
# Example: https://pub-xxxxxx.r2.dev
R2_PUBLIC_URL=https://your_public_url

# --- APP SETTINGS ---
# For CORS configuration (Frontend URL)
FRONTEND_URL=http://localhost:5173
SERVER_PORT=8080

# --- LOGGING ---
# Set to DEBUG or INFO
LOGGING_LEVEL=INFO